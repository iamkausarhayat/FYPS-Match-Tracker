@{
    ViewData["Title"] = "Choose your role";
}

<partial name="_TopBar" />

<section class="page-hero">
    <div class="container">
        <h1 class="fw-bold mb-2">Welcome! Who are you?</h1>
        <p class="lead mb-4" style="opacity: .9;">Choose how you want to continue.</p>
        <span class="info-strip">
            <i class="bi bi-info-circle"></i>
            Already registered? Pick your role and log in. New student? Pick Student, then press Register.
        </span>
    </div>
</section>

<section class="container page-body">
    <div class="row g-4 justify-content-center">

        <div class="col-md-6 col-lg-4">
            <a href="/Account/StudentLogin" class="role-card" aria-label="Continue as Student">
                <div class="role-icon role-student"><i class="bi bi-mortarboard-fill"></i></div>
                <h4 class="fw-bold">Student</h4>
                <p class="text-muted mb-0">Upload your FYP proposal and check it.</p>
                <span class="role-cta">Continue as Student <i class="bi bi-arrow-right"></i></span>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a href="/Account/AdminLogin" class="role-card" aria-label="Continue as Admin">
                <div class="role-icon role-admin"><i class="bi bi-shield-lock-fill"></i></div>
                <h4 class="fw-bold">Admin</h4>
                <p class="text-muted mb-0">Manage the department's FYP records for the comparison.</p>
                <span class="role-cta">Continue as Admin <i class="bi bi-arrow-right"></i></span>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a href="/Check/Upload" class="role-card" aria-label="Continue as Guest">
                <div class="role-icon role-guest"><i class="bi bi-person-fill"></i></div>
                <h4 class="fw-bold">Guest</h4>
                <p class="text-muted mb-0">Quickly check an idea without an account.</p>
                <span class="role-cta">Continue as Guest <i class="bi bi-arrow-right"></i></span>
            </a>
        </div>

    </div>
</section>

<footer class="text-center py-4 text-muted small">
    &copy; 2026 NUML Islamabad &bull; Advance Programming Project
</footer>