@model StudentLoginViewModel
@{
    ViewData["Title"] = "Student Login";
}

<partial name="_TopBar" />

<section class="auth-wrap">
    <div class="auth-card">
        <div class="auth-head">
            <div class="role-icon role-student mx-auto mb-3"><i class="bi bi-mortarboard-fill"></i></div>
            <h2 class="fw-bold">Student Login</h2>
            <p class="text-muted mb-0">Welcome back! Log in to check your FYP idea.</p>
        </div>

        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle"></i> @successMessage
            </div>
        }

        <form asp-action="StudentLogin" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="you@numl.edu.pk" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                <div class="input-group input-group-lg">
                    <input asp-for="Password" class="form-control" placeholder="Your password" autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary" data-toggle-password="#Password" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-brand">Log in <i class="bi bi-box-arrow-in-right"></i></button>
        </form>

        <div class="or-divider"><span>New student?</span></div>

        <a asp-action="StudentRegister" class="btn-outline-brand">Create a student account</a>

        <div class="text-center mt-4">
            <a asp-action="Choose" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Back to role selection</a>
        </div>
    </div>
</section>