@model MatchItemViewModel
@{
    var finalPercent = (int)Math.Round(Model.FinalScore);
    var scoreTone = finalPercent > 75 ? "score-high" : finalPercent >= 45 ? "score-moderate" : "score-low";
}

@* data-university is used by the university filter on the result page *@
<div class="match-card match-item" data-university="@Model.UniversityShort">
    <div class="d-flex align-items-start gap-3">
        <div class="score-pill score-@Model.ScoreClass @scoreTone" aria-label="@finalPercent percent similarity">@finalPercent%</div>

        <div class="flex-grow-1">
            <div class="match-metadata mb-1">
                @if (!string.IsNullOrWhiteSpace(Model.UniversityShort))
                {
                    <span class="uni-tag"><i class="uil uil-university" aria-hidden="true"></i> @Model.UniversityShort</span>
                }
                @if (Model.Year > 0)
                {
                    <span class="chip">@Model.Year</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Area))
                {
                    <span class="chip">@Model.Area</span>
                }
                @if (Model.IsLowConfidence)
                {
                    <span class="low-conf-tag" title="This project only had a title, so the match is less reliable.">
                        <i class="uil uil-exclamation-triangle" aria-hidden="true"></i> Low confidence
                    </span>
                }
            </div>

            <h5 class="fw-bold mb-1">@Model.Title</h5>

            @if (!string.IsNullOrWhiteSpace(Model.Supervisor))
            {
                <div class="text-muted small mb-2">Supervisor: @Model.Supervisor</div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.Authors))
            {
                <div class="text-muted small mb-2">Authors (as listed): @Model.Authors</div>
            }

            <div class="research-match-breakdown" aria-label="Similarity breakdown">
                <div class="research-match-breakdown-row">
                    <span>Semantic</span>
                    <strong>@Math.Round(Model.MeaningScore)%</strong>
                </div>
                <div class="research-match-meter" role="progressbar" aria-label="Semantic similarity" aria-valuenow="@Math.Round(Model.MeaningScore)" aria-valuemin="0" aria-valuemax="100">
                    <span style="width:@Math.Round(Model.MeaningScore)%"></span>
                </div>
                <div class="research-match-breakdown-row">
                    <span>Lexical</span>
                    <strong>@Math.Round(Model.WordScore)%</strong>
                </div>
                <div class="research-match-meter lexical" role="progressbar" aria-label="Lexical similarity" aria-valuenow="@Math.Round(Model.WordScore)" aria-valuemin="0" aria-valuemax="100">
                    <span style="width:@Math.Round(Model.WordScore)%"></span>
                </div>
            </div>

            @if (Model.CommonKeywords.Count > 0 || !string.IsNullOrWhiteSpace(Model.BestPassage))
            {
                <details class="match-overlap">
                    <summary>View overlap highlights</summary>
                    <div class="match-overlap-content">
                        @if (Model.CommonKeywords.Count > 0)
                        {
                            <div class="mb-2">
                                <span class="small text-muted me-1">Common keywords:</span>
                                @foreach (var word in Model.CommonKeywords)
                                {
                                    <span class="chip">@word</span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.BestPassage))
                        {
                            <div class="quote">
                                <span class="small text-muted d-block mb-1">Why it matched (best passage)</span>
                                @Model.BestPassage
                            </div>
                        }
                    </div>
                </details>
            }

            <div class="d-flex flex-wrap gap-2 align-items-center no-print mt-2">
                @if (Model.HasSourceUrl)
                {
                    <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer"
                       class="btn-brand auto-width open-original" style="padding: .4rem 1.1rem; font-size: .88rem;">
                        <i class="uil uil-external-link-alt" aria-hidden="true"></i> Open original project
                    </a>
                }
                else
                {
                    <span class="link-missing"><i class="uil uil-link-broken" aria-hidden="true"></i> Link not available</span>
                }

                @if (Model.ProjectId.HasValue)
                {
                    <button type="button" class="btn-outline-brand auto-width view-fyp"
                            style="padding: .4rem 1.1rem; font-size: .88rem;"
                            data-project-id="@Model.ProjectId">
                        <i class="uil uil-eye" aria-hidden="true"></i> Details
                    </button>
                }
            </div>
        </div>
    </div>
</div>