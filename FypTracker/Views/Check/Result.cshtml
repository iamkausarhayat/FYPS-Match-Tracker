@model SimilarityResultViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Your result";
    var top = Model.TopMatch;
    var others = Model.OtherMatches;
    var filterNames = Model.UniversityFilterNames;
    var papersNote = TempData["PapersNote"] as string;
    var liveNote = TempData["LiveNote"] as string;
    var verdictIcon = Model.VerdictClass == "done" ? "uil-times-circle" : "uil-check-circle";

    // Yeh data "Download PDF" button ke liye page mein rakha jata hai (browser PDF khud banata hai)
    var reportJson = JsonSerializer.Serialize(new
    {
        title = Model.Title,
        supervisor = Model.SupervisorName,
        fileName = Model.FileName,
        verdict = Model.Verdict,
        verdictClass = Model.VerdictClass,
        percent = Model.OverallPercent,
        advice = Model.Advice,
        tips = Model.Suggestion?.Tips ?? new List<string>(),
        coverage = Model.CoverageText,
        meaningWeight = (int)Math.Round(SimilarityRules.MeaningWeight * 100),
        wordWeight = (int)Math.Round(SimilarityRules.WordWeight * 100),
        top = top == null ? null : new
        {
            title = top.Title,
            meaning = Math.Round(top.MeaningScore),
            word = Math.Round(top.WordScore),
            overall = Math.Round(top.FinalScore)
        },
        matches = Model.ProjectMatches
            .OrderByDescending(m => m.FinalScore)
            .Take(5)
            .Select(m => new
            {
                title = m.Title,
                detail = m.Detail,
                url = m.SourceUrl,
                lowConfidence = m.IsLowConfidence,
                meaning = Math.Round(m.MeaningScore),
                word = Math.Round(m.WordScore),
                overall = Math.Round(m.FinalScore),
                keywords = m.CommonKeywords,
                passage = m.BestPassage
            }),
        papers = Model.Papers.Select(p => new { title = p.Title, authors = p.Authors, year = p.Year, url = p.Url })
    });
}

<div class="workspace-page-heading">
    <h1>Similarity analysis</h1>
    <p>How your idea compares with collected final year projects and related research.</p>
</div>

<nav class="research-tabs" aria-label="Research tools">
    <a class="research-tab active" href="/Check/Upload"><i class="uil uil-search" aria-hidden="true"></i> Compare Idea</a>
    <a class="research-tab" href="/Browse"><i class="uil uil-graduation-cap" aria-hidden="true"></i> Top FYPs</a>
    <a class="research-tab" href="/Check/Upload#proposalUpload"><i class="uil uil-file-upload-alt" aria-hidden="true"></i> Upload Proposal (PDF/DOCX)</a>
</nav>

<div class="research-page-grid">
    <section class="research-main-column">
        <div class="research-panel-heading">
            <div>
                <h2>Checked idea</h2>
                <span class="research-panel-eyebrow">Your submitted project details and closest match.</span>
            </div>
            <a asp-action="Upload" class="workspace-account"><i class="uil uil-search" aria-hidden="true"></i> New check</a>
        </div>

            <!-- 1. Verdict and score -->
            <div class="research-card result-summary verdict-@Model.VerdictClass mb-3">
                <div class="row align-items-center g-4">
                    <div class="col-md-4 text-center">
                        <div class="gauge" style="--pct:@Model.OverallPercent" role="img" aria-label="Overall similarity @Model.OverallPercent percent">
                            <div class="gauge-inner">
                                <strong>@Model.OverallPercent%</strong>
                                <span>similar</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <span class="verdict-pill"><i class="uil @verdictIcon" aria-hidden="true"></i> @Model.Verdict</span>
                        <h3 class="fw-bold mt-2 mb-1">@Model.Title</h3>

                        @if (!string.IsNullOrWhiteSpace(Model.SupervisorName) || !string.IsNullOrWhiteSpace(Model.FileName))
                        {
                            <p class="text-muted small mb-3">
                                @if (!string.IsNullOrWhiteSpace(Model.SupervisorName))
                                {
                                    <span>Supervisor: @Model.SupervisorName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.FileName))
                                {
                                    <span>@(string.IsNullOrWhiteSpace(Model.SupervisorName) ? "" : " • ")File: @Model.FileName</span>
                                }
                            </p>
                        }

                        <p class="mb-2">
                            <strong>0 to @SimilarityRules.SimilarFrom%</strong> Unique &bull;
                            <strong>@SimilarityRules.SimilarFrom to @SimilarityRules.AlreadyDoneFrom%</strong> Similar &bull;
                            <strong>@SimilarityRules.AlreadyDoneFrom% and above</strong> Already Done
                        </p>

                        <div class="coverage-note">
                            <i class="uil uil-sitemap" aria-hidden="true"></i> @Model.CoverageText
                            This is not a guarantee: projects from universities that do not publish their list are not included.
                        </div>

                        @if (!string.IsNullOrWhiteSpace(liveNote))
                        {
                            <div class="coverage-note mt-2">
                                <i class="uil uil-wifi" aria-hidden="true"></i> @liveNote
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. The project that decided the verdict -->
            @if (top != null)
            {
                <div class="featured-card verdict-@Model.VerdictClass">
                    <span class="featured-label">
                        <i class="uil uil-bullseye" aria-hidden="true"></i>
                        @(Model.Verdict == "Unique" ? "Closest project we found" : "The project behind this score")
                    </span>

                    <div class="d-flex align-items-start gap-3">
                        <div class="score-pill score-@top.ScoreClass">@Math.Round(top.FinalScore)%</div>

                        <div class="flex-grow-1">
                            <div class="mb-1">
                                @if (!string.IsNullOrWhiteSpace(top.UniversityShort))
                                {
                                    <span class="uni-tag"><i class="uil uil-university" aria-hidden="true"></i> @top.UniversityShort</span>
                                }
                                @if (top.Year > 0)
                                {
                                    <span class="chip">@top.Year</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(top.Area))
                                {
                                    <span class="chip">@top.Area</span>
                                }
                                @if (top.IsLowConfidence)
                                {
                                    <span class="low-conf-tag"><i class="uil uil-exclamation-triangle" aria-hidden="true"></i> Low confidence</span>
                                }
                            </div>

                            <h4 class="fw-bold mb-1">@top.Title</h4>

                            @if (!string.IsNullOrWhiteSpace(top.UniversityName))
                            {
                                <div class="text-muted small">@top.UniversityName</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(top.Supervisor))
                            {
                                <div class="text-muted small">Supervisor: @top.Supervisor</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(top.Authors))
                            {
                                <div class="text-muted small">Authors (as listed): @top.Authors</div>
                            }

                            <div class="mt-3">
                                <div class="d-flex justify-content-between small">
                                    <span>Meaning match <span class="text-muted">(@Math.Round(SimilarityRules.MeaningWeight * 100)% of the score)</span></span>
                                    <strong>@Math.Round(top.MeaningScore)%</strong>
                                </div>
                                <div class="meter mb-2" role="progressbar" aria-label="Meaning match" aria-valuenow="@Math.Round(top.MeaningScore)" aria-valuemin="0" aria-valuemax="100">
                                    <span style="width:@Math.Round(top.MeaningScore)%"></span>
                                </div>

                                <div class="d-flex justify-content-between small">
                                    <span>Word match <span class="text-muted">(@Math.Round(SimilarityRules.WordWeight * 100)% of the score)</span></span>
                                    <strong>@Math.Round(top.WordScore)%</strong>
                                </div>
                                <div class="meter mb-3" role="progressbar" aria-label="Word match" aria-valuenow="@Math.Round(top.WordScore)" aria-valuemin="0" aria-valuemax="100">
                                    <span style="width:@Math.Round(top.WordScore)%"></span>
                                </div>
                            </div>

                            @if (top.CommonKeywords.Count > 0)
                            {
                                <div class="mb-2">
                                    <span class="small text-muted me-1">Why it matched, common keywords:</span>
                                    @foreach (var word in top.CommonKeywords)
                                    {
                                        <span class="chip">@word</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(top.BestPassage))
                            {
                                <div class="quote">
                                    <span class="small text-muted d-block mb-1">Most similar part of that project</span>
                                    @top.BestPassage
                                </div>
                            }

                            @if (top.IsLowConfidence)
                            {
                                <p class="small mb-2" style="color: var(--warn);">
                                    <i class="uil uil-exclamation-triangle" aria-hidden="true"></i>
                                    Low confidence: only the title of this project was available, so please open it and read it yourself.
                                </p>
                            }

                            <div class="d-flex flex-wrap gap-2 align-items-center no-print mt-2">
                                @if (top.HasSourceUrl)
                                {
                                    <a href="@top.SourceUrl" target="_blank" rel="noopener noreferrer" class="btn-brand auto-width open-original">
                                        <i class="uil uil-external-link-alt" aria-hidden="true"></i> Open original project
                                    </a>
                                }
                                else
                                {
                                    <span class="link-missing"><i class="uil uil-link-broken" aria-hidden="true"></i> Link not available for this project</span>
                                }

                                @if (top.ProjectId.HasValue)
                                {
                                    <button type="button" class="btn-outline-brand auto-width view-fyp" data-project-id="@top.ProjectId">
                                        <i class="uil uil-eye" aria-hidden="true"></i> Details
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- How the score is calculated -->
                <div class="formula mb-4">
                    <div class="fw-semibold mb-1"><i class="uil uil-calculator-alt" aria-hidden="true"></i> How this score is calculated</div>
                    <div class="small">
                        Final score = @Math.Round(SimilarityRules.MeaningWeight * 100)% &times; Meaning + @Math.Round(SimilarityRules.WordWeight * 100)% &times; Words<br />
                        = @SimilarityRules.MeaningWeight &times; @Math.Round(top.MeaningScore) + @SimilarityRules.WordWeight &times; @Math.Round(top.WordScore)
                        = <strong>@Math.Round(top.FinalScore)%</strong>
                    </div>
                    <div class="small text-muted mt-1">
                        Meaning match compares the ideas inside your text. Word match compares the exact words used.
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted">No projects were available to compare with.</p>
            }

    </section>

    <aside class="research-side-panel" aria-labelledby="matchesPanelTitle">
        <div class="research-panel-heading">
            <div>
                <h2 id="matchesPanelTitle">Matches &amp; Analysis</h2>
                <span class="research-panel-eyebrow">Closest saved FYPs and related research.</span>
            </div>
            <div class="gauge research-gauge" style="--pct:@Model.OverallPercent" role="img" aria-label="Overall similarity @Model.OverallPercent percent">
                <div class="gauge-inner"><strong>@Model.OverallPercent%</strong></div>
            </div>
        </div>

        <div class="research-verdict-badge verdict-@Model.VerdictClass">
            <i class="uil @verdictIcon" aria-hidden="true"></i>
            @if (Model.Verdict == "Unique")
            {
                <span>Not Done · Unique</span>
            }
            else
            {
                <span>@Model.Verdict</span>
            }
        </div>

            <!-- 3. Other matching projects, with a university filter -->
            <h4 class="section-title mt-4 mb-2"><i class="uil uil-folder-open" aria-hidden="true"></i> Database search matches</h4>
            @if (others.Any())
            {
                @if (Model.Verdict == "Unique")
                {
                    <p class="small text-muted">
                        Projects with a score below @SimilarityRules.SimilarFrom% are shown too, so you can see the closest ideas.
                    </p>
                }

                @if (filterNames.Count > 1)
                {
                    <div class="filter-bar no-print">
                        <label for="uniFilter" class="fw-semibold small mb-0"><i class="uil uil-filter" aria-hidden="true"></i> University</label>
                        <select id="uniFilter" class="form-select form-select-sm">
                            <option value="">All universities</option>
                            @foreach (var name in filterNames)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                        <span id="filterCount" class="small text-muted ms-auto" role="status">Showing @others.Count of @others.Count</span>
                    </div>
                }

                <div id="matchList">
                    @foreach (var item in others)
                    {
                        <partial name="_MatchCard" model="item" />
                    }
                </div>
                <p id="noFilterMatch" class="text-muted d-none">No matching projects from this university.</p>
            }
            else
            {
                <p class="text-muted">No other projects were available to compare with.</p>
            }

            <!-- 4. Suggestion -->
            @if (Model.Suggestion != null)
            {
                <div class="suggestion-box research-future-scope verdict-@Model.VerdictClass">
                    <div class="suggestion-title mb-1"><i class="uil uil-lightbulb" aria-hidden="true"></i> Future scope &amp; recommendations</div>
                    <p class="fw-bold mb-1">@Model.Suggestion.Headline</p>
                    <p class="mb-2">@Model.Suggestion.Message</p>

                    @if (Model.Suggestion.Tips.Count > 0)
                    {
                        <ul class="mb-2 ps-3">
                            @foreach (var tip in Model.Suggestion.Tips)
                            {
                                <li>@tip</li>
                            }
                        </ul>
                    }

                    <p class="small text-muted mb-0">
                        @if (Model.Suggestion.IsAi)
                        {
                            <span><i class="uil uil-robot" aria-hidden="true"></i> Written by an AI helper, using your idea and the closest projects. Please check it with your supervisor.</span>
                        }
                        else
                        {
                            <span><i class="uil uil-info-circle" aria-hidden="true"></i> Based on your idea and the closest projects. Please check it with your supervisor.</span>
                        }
                    </p>
                </div>
            }

            <!-- Research papers (Crossref): sirf padhne ke liye, in ka percentage nahi nikalta -->
            <h4 class="section-title mt-4 mb-3"><i class="uil uil-file-alt" aria-hidden="true"></i> Related research papers</h4>
            @if (Model.Papers.Count > 0)
            {
                <p class="small text-muted">
                    Found by searching Crossref with the main keywords of your idea. They are shown for reading only,
                    so no similarity percentage is calculated for them.
                </p>

                @for (int i = 0; i < Model.Papers.Count; i++)
                {
                    var paper = Model.Papers[i];

                    <div class="match-card">
                        <span class="source-tag source-paper"><i class="uil uil-file-alt" aria-hidden="true"></i> Research paper</span>
                        <h5 class="fw-bold mb-1 mt-1">@paper.Title</h5>
                        <div class="text-muted small mb-2">
                            @paper.Authors
                            @* Authors na hon to akela bullet nahi dikhate *@
                            @if (paper.Year.HasValue && !string.IsNullOrEmpty(paper.Authors))
                            {
                                <span>&bull; @paper.Year</span>
                            }
                            else if (paper.Year.HasValue)
                            {
                                <span>@paper.Year</span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(paper.Url))
                        {
                            <a href="@paper.Url" target="_blank" rel="noopener noreferrer" class="small fw-semibold text-decoration-none">
                                Open paper <i class="uil uil-external-link-alt" aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-muted">
                    @(papersNote ?? "No related research papers were saved for this check.")
                </p>
            }

            <!-- What to do next -->
            <div class="next-steps no-print mt-4 mb-5">
                <div class="fw-semibold mb-2">Report actions</div>
                <div class="research-report-actions">
                    <button type="button" id="downloadPdfBtn" class="btn-brand auto-width"><i class="uil uil-file-download-alt" aria-hidden="true"></i> Download PDF report</button>
                    <a asp-action="Upload" class="btn-outline-brand auto-width"><i class="uil uil-refresh" aria-hidden="true"></i> Reset search</a>
                </div>
            </div>

    </aside>
</div>

<script id="reportData" type="application/json">@Html.Raw(reportJson)</script>

<!-- Pop-up: project ki details dekhne ke liye (data /api/projects/{id} se aata hai) -->
<div class="modal fade" id="fypModal" tabindex="-1" aria-labelledby="fypModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fypModalTitle"><i class="uil uil-university" aria-hidden="true"></i> Project details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="fypLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" aria-hidden="true"></div>
                    <div class="small text-muted mt-2">Loading the project...</div>
                </div>
                <div id="fypError" class="alert alert-danger d-none" role="alert"></div>
                <div id="fypContent" class="d-none">
                    <h4 id="fypTitle" class="fw-bold mb-2 text-break"></h4>
                    <div id="fypMeta" class="mb-3"></div>
                    <h6 class="fw-bold">What this project is about</h6>
                    <p id="fypDescription" class="mb-0 text-break" style="white-space: pre-line;"></p>
                    <div id="fypLink" class="mt-3"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-outline-brand auto-width" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/lib/jspdf/jspdf.umd.min.js"></script>
    <script>
        // ---------- PDF banana (browser mein, jsPDF se) ----------
        // data = server ka bheja hua result (reportData JSON)
        function buildReportPdf(data, JsPDF) {
            const doc = new JsPDF({ unit: 'pt', format: 'a4' });
            const W = doc.internal.pageSize.getWidth();
            const H = doc.internal.pageSize.getHeight();
            const M = 44;                 // margin
            const bottom = H - 56;        // is se neeche text nahi jata
            const contentW = W - 2 * M;
            let y = 0;

            const INK = [30, 41, 59];
            const MUTED = [100, 116, 139];
            const NAVY = [11, 42, 107];
            const verdictColors = { unique: [22, 128, 61], similar: [180, 83, 9], done: [185, 28, 28] };
            const accent = verdictColors[data.verdictClass] || verdictColors.unique;

            // PDF ke standard font sirf English/Latin huroof dikha sakte hain, baqi ko '?' bana dete hain
            function clean(text) {
                return String(text == null ? '' : text)
                    .replace(/[‘’]/g, "'")
                    .replace(/[“”]/g, '"')
                    .replace(/[–—]/g, '-')
                    .replace(/•/g, '|')
                    .replace(/\s+/g, ' ')
                    .replace(/[^\x20-\x7E\xA0-\xFF]/g, '?')
                    .trim();
            }

            function ensure(height) {
                if (y + height > bottom) { doc.addPage(); y = M; }
            }

            function write(text, o) {
                o = o || {};
                const size = o.size || 10;
                const indent = o.indent || 0;
                const color = o.color || INK;
                doc.setFont('helvetica', o.style || 'normal');
                doc.setFontSize(size);
                doc.setTextColor(color[0], color[1], color[2]);
                const lines = doc.splitTextToSize(clean(text), contentW - indent);
                const lineHeight = size * 1.35;
                lines.forEach(function (line) {
                    ensure(lineHeight);
                    doc.text(line, M + indent, y + size);
                    if (o.url) { doc.link(M + indent, y, contentW - indent, lineHeight, { url: o.url }); }
                    y += lineHeight;
                });
                y += (o.after == null ? 4 : o.after);
            }

            function heading(text) {
                ensure(40);
                y += 8;
                write(text, { size: 13, style: 'bold', color: NAVY, after: 3 });
                doc.setDrawColor(203, 213, 225);
                doc.setLineWidth(0.8);
                doc.line(M, y, W - M, y);
                y += 10;
            }

            function bar(label, note, value) {
                ensure(30);
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(10);
                doc.setTextColor(INK[0], INK[1], INK[2]);
                doc.text(clean(label), M, y + 10);
                doc.setTextColor(MUTED[0], MUTED[1], MUTED[2]);
                doc.setFontSize(9);
                doc.text(clean(note), M + doc.getTextWidth(clean(label)) * 1.08 + 6, y + 10);
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(10);
                doc.setTextColor(INK[0], INK[1], INK[2]);
                doc.text(value + '%', W - M, y + 10, { align: 'right' });
                y += 16;
                doc.setFillColor(226, 232, 240);
                doc.roundedRect(M, y, contentW, 6, 3, 3, 'F');
                const filled = Math.max(0, Math.min(100, value)) / 100 * contentW;
                if (filled > 1) {
                    doc.setFillColor(accent[0], accent[1], accent[2]);
                    doc.roundedRect(M, y, filled, 6, 3, 3, 'F');
                }
                y += 16;
            }

            // ----- Top band -----
            doc.setFillColor(NAVY[0], NAVY[1], NAVY[2]);
            doc.rect(0, 0, W, 72, 'F');
            doc.setTextColor(255, 255, 255);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(19);
            doc.text('FYP Match Tracker', M, 33);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(11);
            doc.text('Similarity Report', M, 54);
            const today = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
            doc.setFontSize(10);
            doc.text(today, W - M, 54, { align: 'right' });
            y = 72 + 26;

            // ----- Title, supervisor, file -----
            write(data.title, { size: 16, style: 'bold', after: 4 });
            if (data.supervisor) { write('Supervisor: ' + data.supervisor, { size: 10, color: MUTED, after: 1 }); }
            if (data.fileName) { write('File: ' + data.fileName, { size: 10, color: MUTED, after: 1 }); }
            if (data.coverage) { write(data.coverage, { size: 9, color: MUTED, after: 1 }); }
            y += 10;

            // ----- Verdict box -----
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(10);
            const adviceLines = doc.splitTextToSize(clean(data.advice), contentW - 140);
            const boxHeight = Math.max(78, 44 + adviceLines.length * 13 + 14);
            ensure(boxHeight + 10);
            doc.setDrawColor(accent[0], accent[1], accent[2]);
            doc.setLineWidth(1.5);
            doc.roundedRect(M, y, contentW, boxHeight, 8, 8, 'S');
            doc.setTextColor(accent[0], accent[1], accent[2]);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(30);
            doc.text(data.percent + '%', M + 18, y + 46);
            doc.setFontSize(9);
            doc.setFont('helvetica', 'normal');
            doc.text('similar', M + 18, y + 62);
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(14);
            doc.text(clean(data.verdict), M + 122, y + 28);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(10);
            doc.setTextColor(INK[0], INK[1], INK[2]);
            doc.text(adviceLines, M + 122, y + 46);
            y += boxHeight + 18;

            // ----- Score breakdown -----
            if (data.top) {
                bar('Meaning match', '(' + data.meaningWeight + '% of the score)', data.top.meaning);
                bar('Word match', '(' + data.wordWeight + '% of the score)', data.top.word);
                write('Final score = ' + data.meaningWeight + '% x Meaning + ' + data.wordWeight + '% x Words = ' +
                      (data.meaningWeight / 100) + ' x ' + data.top.meaning + ' + ' + (data.wordWeight / 100) + ' x ' + data.top.word +
                      ' = ' + data.top.overall + '%', { size: 9, color: MUTED, after: 2 });
                write('Closest match: ' + data.top.title, { size: 9, color: MUTED, after: 2 });
            }

            // ----- Suggestion -----
            if (data.tips && data.tips.length) {
                heading('Our suggestion');
                data.tips.forEach(function (tip) { write('- ' + tip, { size: 10, after: 3 }); });
            }

            // ----- Department FYPs -----
            heading('Closest projects');
            if (data.matches.length === 0) {
                write('No projects were available to compare with.', { color: MUTED });
            }
            data.matches.forEach(function (m, index) {
                ensure(80);
                write((index + 1) + '. ' + m.title, { size: 11, style: 'bold', after: 2 });
                write(m.detail, { size: 9, color: MUTED, after: 2 });
                if (m.lowConfidence) { write('Low confidence: only the title of this project was available.', { size: 9, color: MUTED, after: 2 }); }
                if (m.url) { write(m.url, { size: 8, color: [37, 99, 235], url: m.url, after: 2 }); }
                write('Overall ' + m.overall + '%   |   Meaning ' + m.meaning + '%   |   Words ' + m.word + '%',
                      { size: 9, style: 'bold', color: accent, after: 3 });
                if (m.keywords && m.keywords.length) {
                    write('Common keywords: ' + m.keywords.join(', '), { size: 9, after: 3 });
                }
                if (m.passage) {
                    write('Why it matched: "' + m.passage + '"', { size: 9, style: 'italic', color: MUTED, indent: 10, after: 3 });
                }
                y += 4;
                if (y + 8 <= bottom) {   // page ke bilkul end par ho to line nahi khenchte
                    doc.setDrawColor(226, 232, 240);
                    doc.setLineWidth(0.6);
                    doc.line(M, y, W - M, y);
                }
                y += 12;
            });

            // ----- Research papers -----
            if (data.papers.length > 0) {
                heading('Related research papers');
                write('Found with Crossref using the main keywords of your idea. Shown for reading only; no percentage is calculated.',
                      { size: 9, color: MUTED, after: 8 });
                data.papers.forEach(function (p) {
                    ensure(50);
                    write(p.title, { size: 10, style: 'bold', after: 1 });
                    const who = [p.authors, p.year].filter(Boolean).join('  |  ');
                    if (who) { write(who, { size: 9, color: MUTED, after: 1 }); }
                    if (p.url) { write(p.url, { size: 8, color: [37, 99, 235], url: p.url, after: 8 }); }
                });
            }

            // ----- Footer on every page -----
            const pages = doc.getNumberOfPages();
            for (let i = 1; i <= pages; i++) {
                doc.setPage(i);
                doc.setFont('helvetica', 'normal');
                doc.setFontSize(8);
                doc.setTextColor(MUTED[0], MUTED[1], MUTED[2]);
                doc.text('Generated by FYP Match Tracker', M, H - 28);
                doc.text('Page ' + i + ' of ' + pages, W - M, H - 28, { align: 'right' });
            }

            return doc;
        }

        (function () {
            // ---------- Download PDF ----------
            const downloadBtn = document.getElementById('downloadPdfBtn');

            downloadBtn.addEventListener('click', function () {
                if (!window.jspdf || !window.jspdf.jsPDF) {
                    alert('The PDF tool could not be loaded. Please refresh the page and try again.');
                    return;
                }

                try {
                    const data = JSON.parse(document.getElementById('reportData').textContent);
                    const doc = buildReportPdf(data, window.jspdf.jsPDF);
                    const slug = String(data.title || 'idea').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 40);
                    doc.save('FYP-report-' + (slug || 'idea') + '.pdf');   // seedha download hota hai
                } catch (error) {
                    console.error(error);
                    alert('The PDF could not be created. Please try again.');
                }
            });

            // ---------- University filter (works instantly, no server call) ----------
            const uniFilter = document.getElementById('uniFilter');
            if (uniFilter) {
                const items = Array.from(document.querySelectorAll('#matchList .match-item'));
                const countBox = document.getElementById('filterCount');
                const emptyBox = document.getElementById('noFilterMatch');

                uniFilter.addEventListener('change', function () {
                    const wanted = uniFilter.value;
                    let shown = 0;

                    items.forEach(function (item) {
                        const show = !wanted || item.getAttribute('data-university') === wanted;
                        item.classList.toggle('d-none', !show);
                        if (show) { shown++; }
                    });

                    countBox.textContent = 'Showing ' + shown + ' of ' + items.length;
                    emptyBox.classList.toggle('d-none', shown !== 0);
                });
            }

            // ---------- View project details (pop-up) ----------
            const modalElement = document.getElementById('fypModal');
            const loading = document.getElementById('fypLoading');
            const errorBox = document.getElementById('fypError');
            const content = document.getElementById('fypContent');
            const titleBox = document.getElementById('fypTitle');
            const metaBox = document.getElementById('fypMeta');
            const descriptionBox = document.getElementById('fypDescription');
            const linkBox = document.getElementById('fypLink');
            const apiBase = '@Url.Content("~/api/projects")';
            const fypModal = new bootstrap.Modal(modalElement);
            let requestNumber = 0;   // purana jawab der se aaye to ignore karne ke liye

            function addChip(text) {
                const chip = document.createElement('span');
                chip.className = 'chip';
                chip.textContent = text;   // textContent: data HTML ban kar nahi chalta (safe)
                metaBox.appendChild(chip);
            }

            document.addEventListener('click', async function (event) {
                const button = event.target.closest('.view-fyp');
                if (!button) { return; }

                const mine = ++requestNumber;
                loading.classList.remove('d-none');
                errorBox.classList.add('d-none');
                content.classList.add('d-none');
                fypModal.show();

                try {
                    const response = await fetch(apiBase + '/' + encodeURIComponent(button.getAttribute('data-project-id')),
                        { headers: { 'Accept': 'application/json' } });

                    if (!response.ok) { throw new Error('Status ' + response.status); }
                    const project = await response.json();
                    if (mine !== requestNumber) { return; }

                    titleBox.textContent = project.title;
                    descriptionBox.textContent = project.description;
                    metaBox.innerHTML = '';
                    if (project.university) { addChip(project.university); }
                    addChip(project.department);
                    addChip(String(project.year));
                    if (project.supervisorName) { addChip('Supervisor: ' + project.supervisorName); }
                    if (project.isTitleOnly) { addChip('Low confidence: title only'); }

                    // Original project link (only real http / https links)
                    linkBox.innerHTML = '';
                    if (project.sourceUrl && /^https?:\/\//i.test(project.sourceUrl)) {
                        const link = document.createElement('a');
                        link.href = project.sourceUrl;
                        link.target = '_blank';
                        link.rel = 'noopener noreferrer';
                        link.className = 'btn-brand auto-width';
                        link.textContent = 'Open original project';
                        linkBox.appendChild(link);
                    } else {
                        linkBox.textContent = 'Link not available for this project.';
                    }

                    loading.classList.add('d-none');
                    content.classList.remove('d-none');
                } catch (error) {
                    if (mine !== requestNumber) { return; }
                    loading.classList.add('d-none');
                    errorBox.textContent = 'This project could not be loaded. It may have been removed. Please try again.';
                    errorBox.classList.remove('d-none');
                }
            });
        })();
    </script>
}