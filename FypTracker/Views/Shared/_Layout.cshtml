<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FYP Match Tracker</title>
    <link rel="icon" href="~/favicon.ico" />

    @* Theme pehle hi laga do (page khulte hi), taake rang ka jhatka na aaye. Key 'theme' site.js mein bhi yehi hai *@
    <script>
            (function () {
                try {
                    var pref = localStorage.getItem('theme') || 'system';
                    var dark = pref === 'dark' || (pref === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                    var theme = dark ? 'dark' : 'light';
                    document.documentElement.setAttribute('data-theme', theme);
                    document.documentElement.setAttribute('data-bs-theme', theme);
                } catch (e) { }
            })();
    </script>

    @* Bootstrap aur Icons CDN se aate hain (internet chahiye) *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Har page apni extra scripts yahan bhej sakta hai: @section Scripts { ... } *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>