@model BrowseItem

@* Ek project card. Browse page aur home page dono isay use karte hain. *@
<article class="match-card proj-card h-100" data-project-card
         data-title="@Model.Title" data-university="@Model.UniversityName" data-year="@Model.Year"
         data-area="@Model.Area" data-description="@Model.Description" data-supervisor="@Model.Supervisor"
         data-authors="@Model.Authors" data-award="@(Model.IsAward ? Model.AwardText ?? "Award winner" : "")"
         data-source="@Model.SourceUrl" data-title-only="@Model.IsTitleOnly.ToString().ToLowerInvariant()">
    <div class="mb-1">
        @if (Model.IsAward)
        {
            <span class="award-tag" title="@(Model.AwardText ?? "Award winner")">
                <i class="bi bi-trophy-fill"></i> @(string.IsNullOrWhiteSpace(Model.AwardText) ? "Award winner" : Model.AwardText)
            </span>
        }
        <span class="uni-tag" title="@Model.UniversityName"><i class="bi bi-building"></i> @Model.University</span>
        @if (Model.Year > 0)
        {
            <span class="chip">@Model.Year</span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Area))
        {
            <span class="chip">@Model.Area</span>
        }
        @if (Model.IsTitleOnly)
        {
            <span class="low-conf-tag" title="Only the title of this project is available.">
                <i class="bi bi-exclamation-triangle"></i> Title only
            </span>
        }
    </div>

    <h5 class="fw-bold mb-1">@Model.Title</h5>

    @if (!string.IsNullOrWhiteSpace(Model.Supervisor))
    {
        <div class="text-muted small mb-2">Supervisor: @Model.Supervisor</div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Authors))
    {
        <div class="text-muted small mb-2">Authors (as listed): @Model.Authors</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="small mb-2">@Model.Snippet</p>

        if (Model.HasMore)
        {
            <details class="small mb-2">
                <summary>Read full description</summary>
                <p class="mt-2 mb-0">@Model.Description</p>
            </details>
        }
    }

    <div class="mt-2 d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn-outline-brand auto-width quick-view" data-project-quick-view aria-pressed="false">
            <i class="bi bi-eye"></i> Quick view
        </button>
        @if (Model.HasSourceUrl)
        {
            <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer"
               class="btn-brand auto-width open-original" style="padding: .4rem 1.1rem; font-size: .88rem;">
                <i class="bi bi-box-arrow-up-right"></i> Open original project
            </a>
        }
        else
        {
            <span class="link-missing"><i class="bi bi-link-45deg"></i> Link not available</span>
        }
    </div>
</article>
