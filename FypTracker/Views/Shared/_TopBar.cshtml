@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<header class="topbar site-header">
    <div class="container header-shell">
        <nav class="header-links header-links-left" aria-label="Primary navigation">
            <a href="/" class="nav-link-soft @(controller == "Home" && action == "Index" ? "active" : "")"><i class="bi bi-house"></i><span>Home</span></a>
            <a href="/Browse" class="nav-link-soft @(controller == "Browse" ? "active" : "")"><i class="bi bi-collection"></i><span>Browse projects</span></a>
        </nav>

        <a href="/" class="brand brand-centered" aria-label="FYP Match Tracker home">
            <partial name="_BrandMark" />
            <span class="brand-name">FYP Match Tracker<small>Ideas, checked against real projects</small></span>
        </a>

        <button class="nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#siteMenu"
                aria-controls="siteMenu" aria-expanded="false" aria-label="Open menu">
            <i class="bi bi-list"></i>
        </button>

        <div class="header-actions">
            <a href="/Check/Upload" class="nav-link-soft check-link @(controller == "Check" ? "active" : "")"><i class="bi bi-search"></i><span>Check an idea</span></a>
            <partial name="_ThemeSwitcher" />
            @if (isLoggedIn)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="nav-link-soft border-0 bg-transparent"><i class="bi bi-box-arrow-right"></i><span>Log out</span></button>
                </form>
            }
            else
            {
                <a href="/Account/Choose" class="btn-gold btn-small login-link"><i class="bi bi-box-arrow-in-right"></i><span>Log in</span></a>
            }
        </div>

        <div class="nav-collapse collapse" id="siteMenu">
            <nav class="mobile-menu" aria-label="Mobile navigation">
                <a href="/" class="nav-link-soft @(controller == "Home" && action == "Index" ? "active" : "")"><i class="bi bi-house"></i> Home</a>
                <a href="/Browse" class="nav-link-soft @(controller == "Browse" ? "active" : "")"><i class="bi bi-collection"></i> Browse projects</a>
                <a href="/Check/Upload" class="nav-link-soft @(controller == "Check" ? "active" : "")"><i class="bi bi-search"></i> Check an idea</a>
                <partial name="_ThemeSwitcher" />
                @if (isLoggedIn)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="nav-link-soft border-0 bg-transparent"><i class="bi bi-box-arrow-right"></i> Log out</button>
                    </form>
                }
                else
                {
                    <a href="/Account/Choose" class="nav-link-soft"><i class="bi bi-person-circle"></i> Log in</a>
                }
            </nav>
        </div>
    </div>
</header>
