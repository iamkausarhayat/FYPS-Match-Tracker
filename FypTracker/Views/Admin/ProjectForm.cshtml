@model ProjectFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit project" : "Add project";
}

<partial name="_AdminBar" />

<section class="page-hero compact">
    <div class="container">
        <h1 class="fw-bold mb-2">@(Model.IsEdit ? "Edit project" : "Add a new project")</h1>
        <p class="lead mb-0" style="opacity: .9;">
            @(Model.IsEdit ? "Update the details below and save." : "Fill in the details of the completed FYP.")
        </p>
    </div>
</section>

<section class="container page-body">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="step-card">

                <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-semibold">Project title</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Smart Parking with Occupancy Prediction" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold"></label>
                            <select asp-for="Department" class="form-select form-select-lg">
                                <option value="">Select department</option>
                                @foreach (var d in DepartmentOptions.All)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Year" class="form-label fw-semibold">Completion year</label>
                            <input asp-for="Year" type="number" class="form-control form-control-lg" />
                            <span asp-validation-for="Year" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="SupervisorName" class="form-label fw-semibold"></label>
                            <input asp-for="SupervisorName" class="form-control form-control-lg" placeholder="e.g. Dr. Ahmed Raza" />
                            <span asp-validation-for="SupervisorName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" rows="6" class="form-control"
                                      placeholder="Explain the problem, the users, the main features and the technology."></textarea>
                            <div class="d-flex justify-content-between">
                                <span asp-validation-for="Description" class="text-danger small"></span>
                                <span class="form-text ms-auto"><span id="descCount">0</span> / 3000 (minimum 50)</span>
                            </div>
                            <div class="form-text">The AI compares student ideas with this text, so a clear description gives better results.</div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <button type="submit" class="btn-brand auto-width">
                            <i class="bi bi-check2-circle"></i> @(Model.IsEdit ? "Save changes" : "Add project")
                        </button>
                        <a asp-action="Projects" class="btn-outline-brand auto-width">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

<footer class="text-center py-4 text-muted small">
    &copy; 2026 NUML Islamabad &bull; Advance Programming Project
</footer>

@section Scripts {
    <script>
        const description = document.getElementById('Description');
        const counter = document.getElementById('descCount');

        function updateCount() {
            const length = description.value.length;
            counter.textContent = length;
            const good = length >= 50 && length <= 3000;
            counter.classList.toggle('count-ok', good);
            counter.classList.toggle('count-bad', !good);
        }

        description.addEventListener('input', updateCount);
        updateCount();
    </script>
}