@model ProjectFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit project" : "Add project";
}

<partial name="_AdminBar" />

<section class="page-hero compact">
    <div class="container">
        <h1 class="fw-bold mb-2">@(Model.IsEdit ? "Edit project" : "Add a new project")</h1>
        <p class="lead mb-0" style="opacity: .9;">
            @(Model.IsEdit ? "Update the details below and save." : "Fill in the details of the completed FYP.")
        </p>
    </div>
</section>

<section class="container page-body">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="step-card">

                <!-- Optional: file se title aur abstract khud bhar do. Ye form ke BAHAR hai, is liye file save nahi hoti. -->
                <div class="step-title"><span class="step-no"><i class="bi bi-magic"></i></span> Fill from a file (optional)</div>

                <div id="adminDropZone" class="drop-zone" tabindex="0" role="button" aria-label="Choose a file to read">
                    <i class="bi bi-cloud-arrow-up"></i>
                    <p class="mb-1 fw-semibold mt-2">Drag and drop a report, or click to browse</p>
                    <p class="small text-muted mb-0">PDF, Word (.docx) or text (.txt) &bull; up to 5 MB &bull; scanned PDFs are read with OCR</p>
                </div>
                <input id="adminFile" type="file" class="d-none" accept=".pdf,.docx,.txt" />

                <div id="adminExtractNote" class="small mt-2 text-muted" role="status"></div>
                <div id="adminFileError" class="text-danger small mt-2" role="alert"></div>
            </div>

            <div class="step-card">

                <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-semibold">Project title</label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Smart Parking with Occupancy Prediction" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="University" class="form-label fw-semibold"></label>
                            <select asp-for="University" class="form-select form-select-lg">
                                <option value="">Select university</option>
                                @foreach (var u in (List<string>)ViewBag.Universities)
                                {
                                    <option value="@u">@u</option>
                                }
                            </select>
                            <span asp-validation-for="University" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold"></label>
                            <select asp-for="Department" class="form-select form-select-lg">
                                <option value="">Select department</option>
                                @foreach (var d in DepartmentOptions.All)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Year" class="form-label fw-semibold">Completion year</label>
                            <input asp-for="Year" type="number" class="form-control form-control-lg" />
                            <span asp-validation-for="Year" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="SupervisorName" class="form-label fw-semibold"></label>
                            <input asp-for="SupervisorName" class="form-control form-control-lg" placeholder="e.g. Dr. Ahmed Raza" />
                            <span asp-validation-for="SupervisorName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Area" class="form-label fw-semibold"></label>
                            <input asp-for="Area" class="form-control form-control-lg" placeholder="e.g. Computer vision" />
                            <span asp-validation-for="Area" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SourceUrl" class="form-label fw-semibold"></label>
                            <input asp-for="SourceUrl" class="form-control form-control-lg" placeholder="https://..." />
                            <span asp-validation-for="SourceUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" rows="6" class="form-control"
                                      placeholder="Explain the problem, the users, the main features and the technology."></textarea>
                            <div class="d-flex justify-content-between">
                                <span asp-validation-for="Description" class="text-danger small"></span>
                                <span class="form-text ms-auto"><span id="descCount">0</span> / 3000 (50 or more, or empty)</span>
                            </div>
                            <div class="form-text">The AI compares student ideas with this text, so a clear description gives better results. If only the title is known, leave it empty.</div>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsAward" class="form-check-input" />
                                <label asp-for="IsAward" class="form-check-label fw-semibold">This project won an award (show it in the top FYPs on the home page)</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="AwardText" class="form-label fw-semibold"></label>
                            <input asp-for="AwardText" class="form-control form-control-lg" placeholder="e.g. Best FYP 2024" />
                            <span asp-validation-for="AwardText" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <button type="submit" class="btn-brand auto-width">
                            <i class="bi bi-check2-circle"></i> @(Model.IsEdit ? "Save changes" : "Add project")
                        </button>
                        <a asp-action="Projects" class="btn-outline-brand auto-width">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>



@section Scripts {
    <script>
        const description = document.getElementById('Description');
        const counter = document.getElementById('descCount');

        function updateCount() {
            const length = description.value.length;
            counter.textContent = length;
            const good = length === 0 || (length >= 50 && length <= 3000);
            counter.classList.toggle('count-ok', good);
            counter.classList.toggle('count-bad', !good);
        }

        description.addEventListener('input', updateCount);
        updateCount();

        // ---------- File se title aur abstract nikalna ----------
        (function () {
            const zone = document.getElementById('adminDropZone');
            const input = document.getElementById('adminFile');
            const note = document.getElementById('adminExtractNote');
            const error = document.getElementById('adminFileError');
            const title = document.getElementById('Title');
            const form = document.querySelector('form[method="post"]');
            const extractUrl = '@Url.Action("ExtractText", "Admin")';
            const allowed = ['pdf', 'docx', 'txt'];
            const maxBytes = 5 * 1024 * 1024;
            let requestNumber = 0;

            zone.addEventListener('click', () => input.click());
            zone.addEventListener('keydown', e => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
            });
            ['dragenter', 'dragover'].forEach(n => zone.addEventListener(n, e => { e.preventDefault(); zone.classList.add('dragging'); }));
            ['dragleave', 'drop'].forEach(n => zone.addEventListener(n, e => { e.preventDefault(); zone.classList.remove('dragging'); }));
            zone.addEventListener('drop', e => {
                if (e.dataTransfer.files.length) { input.files = e.dataTransfer.files; handleFile(); }
            });
            input.addEventListener('change', handleFile);

            function handleFile() {
                error.textContent = '';
                note.textContent = '';
                const file = input.files[0];
                if (!file) { return; }

                const ext = file.name.split('.').pop().toLowerCase();
                if (!allowed.includes(ext)) { error.textContent = 'Only PDF, Word (.docx) or text (.txt) files are allowed.'; input.value = ''; return; }
                if (file.size === 0) { error.textContent = 'The file is empty.'; input.value = ''; return; }
                if (file.size > maxBytes) { error.textContent = 'The file is too big. Maximum size is 5 MB.'; input.value = ''; return; }

                extract(file);
            }

            async function extract(file) {
                const mine = ++requestNumber;
                note.textContent = 'Reading your file... (a scanned PDF can take up to a minute)';

                try {
                    const data = new FormData();
                    data.append('document', file);
                    data.append('__RequestVerificationToken',
                        form.querySelector('input[name="__RequestVerificationToken"]').value);

                    const response = await fetch(extractUrl, { method: 'POST', body: data });
                    const result = await response.json();

                    if (mine !== requestNumber) { return; }

                    if (!result.ok) {
                        note.textContent = '';
                        error.textContent = result.message;
                        input.value = '';
                        return;
                    }

                    // Agar form mein pehle se kuch likha hai to poochho, chupke se mita mat do
                    const hasText = title.value.trim() || description.value.trim();
                    if (hasText && !confirm('Replace the current title and description with the text from the file?')) {
                        note.textContent = 'Nothing was changed.';
                        input.value = '';
                        return;
                    }

                    title.value = result.title;
                    description.value = result.description;
                    updateCount();
                    note.textContent = result.note;
                } catch (e) {
                    if (mine !== requestNumber) { return; }
                    note.textContent = '';
                    error.textContent = 'Could not read the file. Please type or paste the text yourself.';
                }

                input.value = '';
            }
        })();
    </script>
}